import type { ReactNode } from 'react';

interface TimelineItemProps {
  year: string;
  title: string;
  url?: string;
}

function TimelineItem({ year, title, url }: TimelineItemProps) {
  return (
    <div className="relative pl-20 pb-8">
      <div className="absolute left-6 top-1 w-4 h-4 bg-blue-600 rounded-full border-4 border-white"></div>
      <div className="bg-white p-4 rounded-lg shadow-md">
        <div className="font-bold text-lg text-blue-600">{year}</div>
        <div className="text-gray-800 mt-1">
          {url ? <a href={url} className="hover:underline">{title}</a> : title}
        </div>
      </div>
    </div>
  );
}

interface CustomTimelineProps {
  children?: ReactNode;
}

export default function CustomTimeline({ children }: CustomTimelineProps) {
  return (
    <div className="timeline-container my-8">
      <div className="relative">
        <div className="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-300"></div>
        {children}
      </div>
    </div>
  );
}

export { TimelineItem };
